body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f4f7fa;
}

header{
    background:#0d47a1;
    color:white;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 50px;
}

nav a{
    color:white;
    text-decoration:none;
    margin-left:20px;
    font-weight:bold;
}

.hero{
    text-align:center;
    padding:100px 20px;
    background:linear-gradient(135deg,#1565c0,#42a5f5);
    color:white;
}

.hero h2{
    font-size:42px;
}

.hero p{
    font-size:20px;
    margin:20px 0;
}

button{
    background:#ff9800;
    color:white;
    border:none;
    padding:15px 35px;
    border-radius:8px;
    font-size:18px;
    cursor:pointer;
}

button:hover{
    background:#f57c00;
}
